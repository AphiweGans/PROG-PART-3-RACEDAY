@model List<EventVm>
@{ ViewData["Title"] = "Organiser dashboard"; }
<section class="dashboard-head"><div><span class="eyebrow">ORGANISER WORKSPACE</span><h1>Your race desk<span class="period">.</span></h1><p>Manage your events, categories, participant entries and finish-line results.</p></div><a class="btn" asp-action="CreateEvent">＋ Create event</a></section>
@if(!string.IsNullOrWhiteSpace(ViewBag.ApiError as string)){<div class="alert error">@ViewBag.ApiError</div>}
<div class="metric-grid"><div class="metric-card"><span>YOUR EVENTS</span><strong>@Model.Count</strong><small>Events managed by you</small></div><div class="metric-card"><span>UPCOMING</span><strong>@Model.Count(e=>e.EventDate.Date>=DateTime.Today)</strong><small>Ready for race day</small></div><div class="metric-card"><span>EVENT TYPES</span><strong>@Model.Select(e=>e.EventType).Distinct().Count()</strong><small>Run, walk or cycle</small></div></div>
<div class="section-heading"><div><span class="eyebrow">EVENT MANAGEMENT</span><h2>Manage your events</h2></div></div>
@if(Model.Count==0){<section class="empty-state"><span class="empty-icon">＋</span><h3>Your first event starts here.</h3><p>Create an event, add categories and invite participants to join.</p><a class="btn" asp-action="CreateEvent">Create your first event</a></section>}else{<div class="manage-list">@foreach(var e in Model){<article class="manage-card"><div class="manage-art">@(e.EventType==2?"↗":e.EventType==1?"◉":"⌁")</div><div class="manage-main"><span class="status-chip @(e.EventDate.Date<DateTime.Today?"muted":"active")">@(e.EventDate.Date<DateTime.Today?"Completed":"Upcoming")</span><h3>@e.EventName</h3><p>@e.EventDate.ToString("dd MMM yyyy") · @e.Location · @e.Distance km</p><div class="manage-links"><a asp-action="Categories" asp-route-eventId="@e.EventId">Categories</a><a asp-action="Enrolments" asp-route-eventId="@e.EventId">Enrolments</a><a asp-action="Results" asp-route-eventId="@e.EventId">Results</a></div></div><div class="manage-actions"><a class="btn btn-small btn-outline" asp-action="EditEvent" asp-route-id="@e.EventId">Edit</a><form asp-action="DeleteEvent" method="post" onsubmit="return confirm('Delete this event and its categories?')"><input type="hidden" name="id" value="@e.EventId"/><button class="btn btn-small btn-danger" type="submit">Delete</button></form><form asp-action="UploadImage" method="post" enctype="multipart/form-data" class="upload-mini"><input type="hidden" name="eventId" value="@e.EventId"/><label class="file-label">@(string.IsNullOrEmpty(e.ImageUrl)?"Add image":"Replace image")<input type="file" name="file" accept="image/jpeg,image/png,image/webp" required/></label><button type="submit" class="text-button">Upload ↑</button></form></div></article> }</div>}
