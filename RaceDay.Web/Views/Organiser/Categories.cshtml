@model List<CategoryVm>
@{ var ev=ViewBag.Event as EventVm; ViewData["Title"]="Event categories"; }
<a class="back-link" asp-action="Index">← Back to dashboard</a><section class="dashboard-head"><div><span class="eyebrow">CATEGORY MANAGEMENT</span><h1>@ev?.EventName<span class="period">.</span></h1><p>Set the distances, entry fees and participant limits for this event.</p></div><a class="btn" asp-action="CreateCategory" asp-route-eventId="@ev?.EventId">＋ Add category</a></section>
@if(Model.Count==0){<section class="empty-state"><h3>No categories yet</h3><p>Add one or more categories so participants can enter.</p><a class="btn" asp-action="CreateCategory" asp-route-eventId="@ev?.EventId">Add first category</a></section>}else{<div class="table-wrap"><table><thead><tr><th>Category</th><th>Distance</th><th>Capacity</th><th>Entry fee</th><th>Action</th></tr></thead><tbody>@foreach(var c in Model){<tr><td><strong>@c.CategoryName</strong></td><td>@c.DistanceKm km</td><td>@c.MaxParticipants</td><td>R @c.EntryFee.ToString("0.00")</td><td><a class="text-button" asp-action="EditCategory" asp-route-id="@c.CategoryId" asp-route-eventId="@c.EventId">Edit</a> &nbsp; <form asp-action="DeleteCategory" method="post" onsubmit="return confirm('Delete this category?')"><input type="hidden" name="id" value="@c.CategoryId"/><input type="hidden" name="eventId" value="@c.EventId"/><button class="text-button danger-text" type="submit">Delete</button></form></td></tr>}</tbody></table></div>}
