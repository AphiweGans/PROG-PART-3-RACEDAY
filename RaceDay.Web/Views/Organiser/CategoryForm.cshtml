@model CategoryFormVm
@{ var editing=Model.CategoryId>0; ViewData["Title"]=editing?"Edit category":"Add category"; }
<a class="back-link" asp-action="Categories" asp-route-eventId="@Model.EventId">← Back to categories</a><section class="form-page"><span class="eyebrow">NEW CATEGORY</span><h1>@(editing?"Edit category":"Add a category")<span class="period">.</span></h1><p>Give participants a distance and a clear entry fee.</p><form asp-action="@(editing?"EditCategory":"CreateCategory")" method="post" class="form-grid"><input asp-for="EventId" type="hidden"/><input asp-for="CategoryId" type="hidden"/><div asp-validation-summary="ModelOnly" class="validation full"></div><div class="field full"><label asp-for="CategoryName">Category name</label><input asp-for="CategoryName" placeholder="e.g. 10 km Open"/><span asp-validation-for="CategoryName" class="validation"></span></div><div class="field"><label asp-for="DistanceKm">Distance (km)</label><input asp-for="DistanceKm" type="number" step="0.01"/><span asp-validation-for="DistanceKm" class="validation"></span></div><div class="field"><label asp-for="MaxParticipants">Participant limit</label><input asp-for="MaxParticipants" type="number" min="1"/><span asp-validation-for="MaxParticipants" class="validation"></span></div><div class="field"><label asp-for="EntryFee">Entry fee (R)</label><input asp-for="EntryFee" type="number" step="0.01" min="0"/><span asp-validation-for="EntryFee" class="validation"></span></div><div class="form-actions full"><button class="btn" type="submit">@(editing?"Save changes":"Save category") →</button></div></form></section>
