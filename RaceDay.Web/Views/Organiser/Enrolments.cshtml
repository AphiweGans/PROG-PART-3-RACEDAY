@model List<JsonElement>
@{ var ev=ViewBag.Event as EventVm; ViewData["Title"]="Event enrolments"; }
<a class="back-link" asp-action="Index">← Back to dashboard</a><section class="page-intro"><span class="eyebrow">PARTICIPANT MANAGEMENT</span><h1>Event entries<span class="period">.</span></h1><p>Review and update entries for <strong>@ev?.EventName</strong>.</p></section>
@if(!string.IsNullOrWhiteSpace(ViewBag.ApiError as string)){<div class="alert error">@ViewBag.ApiError</div>}
@if(Model.Count==0){<section class="empty-state"><h3>No entries yet</h3><p>Participant entries will appear here once people enter your event.</p></section>}else{<div class="table-wrap"><table><thead><tr><th>Participant</th><th>Category</th><th>Entry date</th><th>Status</th><th>Update status</th></tr></thead><tbody>@foreach(var e in Model){var id=e.TryGetProperty("enrolmentID",out var idv)?idv.GetInt32():0;var name=e.TryGetProperty("participant",out var p)&&p.TryGetProperty("fullName",out var n)?n.GetString():"Participant";var category=e.TryGetProperty("categoryName",out var c)?c.GetString():"Category";var status=e.TryGetProperty("status",out var s)?s.GetString():"Confirmed";var date=e.TryGetProperty("enrolmentDate",out var d)&&d.ValueKind==JsonValueKind.String?d.GetDateTime().ToString("dd MMM yyyy"):"—";<tr><td><strong>@name</strong><small class="table-sub">ID #@id</small></td><td>@category</td><td>@date</td><td><span class="status-chip @(status=="Confirmed"?"active":status=="Cancelled"?"danger":"muted")">@status</span></td><td><form asp-action="UpdateStatus" method="post" class="inline-form"><input type="hidden" name="id" value="@id"/><input type="hidden" name="eventId" value="@ev?.EventId"/><select name="status"><option selected="@(status=="Confirmed")">Confirmed</option><option selected="@(status=="Pending")">Pending</option><option selected="@(status=="Cancelled")">Cancelled</option></select><button class="btn btn-small" type="submit">Save</button></form></td></tr>}</tbody></table></div>}
