@model EventFormVm
@{ var editing=Model.EventId>0; ViewData["Title"] = editing?"Edit event":"Create event"; }
<a class="back-link" asp-action="Index">← Back to dashboard</a><section class="form-page"><span class="eyebrow">EVENT SETUP</span><h1>@(editing?"Edit event":"Create an event")<span class="period">.</span></h1><p>Give participants the details they need to get to the start line.</p><form asp-action="@(editing?"EditEvent":"CreateEvent")" method="post" class="form-grid"><input asp-for="EventId" type="hidden"/><div asp-validation-summary="ModelOnly" class="validation full"></div><div class="field full"><label asp-for="EventName">Event name</label><input asp-for="EventName" placeholder="e.g. Cape Coast 10K"/><span asp-validation-for="EventName" class="validation"></span></div><div class="field"><label asp-for="EventDate">Event date</label><input asp-for="EventDate" type="date"/><span asp-validation-for="EventDate" class="validation"></span></div><div class="field"><label asp-for="Location">Location</label><input asp-for="Location" placeholder="City, venue or route"/><span asp-validation-for="Location" class="validation"></span></div><div class="field"><label asp-for="Distance">Distance (km)</label><input asp-for="Distance" type="number" step="0.01" min="0.1"/><span asp-validation-for="Distance" class="validation"></span></div><div class="field"><label asp-for="EventType">Event type</label><select asp-for="EventType"><option value="0">Running</option><option value="1">Walking</option><option value="2">Cycling</option></select></div><div class="field full"><label asp-for="Description">Description</label><textarea asp-for="Description" rows="4" required placeholder="Tell participants what makes this event special."></textarea><span asp-validation-for="Description" class="validation"></span></div><div class="form-actions full"><button class="btn" type="submit">@(editing?"Save changes":"Create event") →</button><a class="text-link" asp-action="Index">Cancel</a></div></form></section>
