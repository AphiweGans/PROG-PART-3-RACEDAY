@model List<ResultVm>
@{ var ev=ViewBag.Event as EventVm; var enrolments=ViewBag.Enrolments as List<JsonElement> ?? new(); ViewData["Title"]="Race results"; }
<a class="back-link" asp-action="Index">← Back to dashboard</a><section class="page-intro"><span class="eyebrow">THE FINISH LINE</span><h1>Race results<span class="period">.</span></h1><p>Capture official times and finishing positions for <strong>@ev?.EventName</strong>.</p></section>
<section class="form-page slim"><h2>Record a result</h2><form asp-action="CaptureResult" method="post" class="form-grid"><input type="hidden" name="eventId" value="@ev?.EventId"/><div class="field full"><label for="EnrolmentId">Participant entry</label><select name="EnrolmentId" id="EnrolmentId" required><option value="">Choose an entry</option>@foreach(var e in enrolments){var id=e.TryGetProperty("enrolmentID",out var iv)?iv.GetInt32():0;var name=e.TryGetProperty("participant",out var p)&&p.TryGetProperty("fullName",out var n)?n.GetString():"Participant";var cat=e.TryGetProperty("categoryName",out var c)?c.GetString():"Category";<option value="@id">@name — @cat (#@id)</option>}</select></div><div class="field"><label for="FinishTime">Finish time (hh:mm:ss)</label><input id="FinishTime" name="FinishTime" value="00:45:00" pattern="[0-9]{2,}:[0-5][0-9]:[0-5][0-9]" required/></div><div class="field"><label for="Position">Finishing position</label><input id="Position" name="Position" type="number" min="1" placeholder="e.g. 1"/></div><div class="field"><label for="Status">Result status</label><select id="Status" name="Status"><option>Finished</option><option>DidNotFinish</option><option>Disqualified</option></select></div><div class="form-actions full"><button class="btn" type="submit">Save result →</button></div></form></section>
<section class="section-heading"><div><span class="eyebrow">OFFICIAL LEADERBOARD</span><h2>Recorded results</h2></div></section>
@if(!string.IsNullOrWhiteSpace(ViewBag.ApiError as string)){<div class="alert error">@ViewBag.ApiError</div>}
@if(Model.Count==0){<section class="empty-state compact"><h3>No results recorded yet</h3><p>Once a result is captured, it will appear here.</p></section>}else{<div class="table-wrap"><table><thead><tr><th>Position</th><th>Participant</th><th>Category</th><th>Finish time</th><th>Status</th></tr></thead><tbody>@foreach(var r in Model.OrderBy(x=>x.Position??int.MaxValue)){<tr><td><span class="rank">@(r.Position?.ToString()??"—")</span></td><td><strong>@r.ParticipantName</strong></td><td>@r.CategoryName</td><td>@(r.FinishTime?.ToString(@"hh\:mm\:ss")??"—")</td><td><span class="status-chip active">@r.Status</span></td></tr>}</tbody></table></div>}
