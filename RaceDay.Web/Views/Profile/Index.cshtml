@model ProfileVm
@{ ViewData["Title"]="My profile"; }
<section class="page-intro"><span class="eyebrow">ACCOUNT SETTINGS</span><h1>Your profile<span class="period">.</span></h1><p>Keep your RaceDay details accurate and up to date.</p></section>
<section class="profile-card"><div class="profile-avatar">@((Model.FullName.FirstOrDefault()).ToString().ToUpperInvariant())</div><div><h2>@Model.FullName</h2><p>@Model.Email</p><span class="role-pill">@Model.Role</span></div></section>
<section class="form-page slim"><h2>Edit your details</h2><form asp-action="Index" method="post" class="form-grid"><input asp-for="UserId" type="hidden"/><input asp-for="Role" type="hidden"/><input asp-for="Email" type="hidden"/><div asp-validation-summary="ModelOnly" class="validation full"></div><div class="field full"><label asp-for="FullName">Full name</label><input asp-for="FullName"/><span asp-validation-for="FullName" class="validation"></span></div><div class="field"><label>Email address</label><input value="@Model.Email" disabled/></div>@if(Model.Role=="Organiser"){<div class="field"><label asp-for="Phone">Phone</label><input asp-for="Phone" placeholder="Optional"/></div>} @if(Model.Role=="Participant"){<div class="field"><label asp-for="Gender">Gender</label><input asp-for="Gender" placeholder="Optional"/></div><div class="field"><label>Date of birth</label><input value="@(Model.DateOfBirth?.ToString("yyyy-MM-dd")??"")" disabled/></div>}<div class="form-actions full"><button class="btn" type="submit">Save profile →</button></div></form></section>
