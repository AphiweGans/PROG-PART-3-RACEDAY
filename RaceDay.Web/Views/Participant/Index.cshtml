@model List<EventVm>
@{ ViewData["Title"]="Participant home"; }
<section class="dashboard-head"><div><span class="eyebrow">YOUR RACEDAY</span><h1>Ready to move, @Context.Session.GetString("UserName")?<span class="period">.</span></h1><p>Find an event, enter your category and keep your progress moving.</p></div><a class="btn" asp-controller="Events" asp-action="Index">Explore events →</a></section>
<div class="quick-links"><a asp-action="MyEvents"><span>01</span><strong>My events</strong><small>View and manage your entries →</small></a><a asp-action="MyResults"><span>02</span><strong>My results</strong><small>Review times and positions →</small></a><a asp-controller="Profile" asp-action="Index"><span>03</span><strong>My profile</strong><small>Keep your details current →</small></a></div>
<section class="section-heading"><div><span class="eyebrow">FIND YOUR NEXT CHALLENGE</span><h2>Upcoming events</h2></div><a class="text-link" asp-controller="Events" asp-action="Index">Browse all →</a></section>
@if(!string.IsNullOrWhiteSpace(ViewBag.ApiError as string)){<div class="alert error">@ViewBag.ApiError</div>}
<div class="event-grid">@foreach(var e in Model.Take(3)){<article class="event-card"><div class="event-image" style="@(string.IsNullOrWhiteSpace(e.ImageUrl)?"":$"background-image:linear-gradient(180deg,transparent,rgba(7,25,22,.55)),url('{e.ImageUrl}')")"><span class="type-tag">@((new[]{"RUN","WALK","CYCLE"}.ElementAtOrDefault(e.EventType))??"EVENT")</span><span class="event-distance">@e.Distance km</span>@if(string.IsNullOrWhiteSpace(e.ImageUrl)){<span class="image-graphic">⌁</span>}</div><div class="event-card-body"><div class="event-date">@e.EventDate.ToString("dd MMM yyyy") · @e.Location</div><h3>@e.EventName</h3><a class="card-link" asp-controller="Events" asp-action="Details" asp-route-id="@e.EventId">View event →</a></div></article>}</div>
