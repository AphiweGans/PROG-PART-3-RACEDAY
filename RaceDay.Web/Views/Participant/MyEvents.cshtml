@model List<EnrolmentVm>
@{ ViewData["Title"]="My events"; }
<section class="page-intro"><span class="eyebrow">YOUR RACE CALENDAR</span><h1>My events<span class="period">.</span></h1><p>All your race entries in one place. Keep showing up for yourself.</p></section>
@if(!string.IsNullOrWhiteSpace(ViewBag.ApiError as string)){<div class="alert error">@ViewBag.ApiError</div>}
@if(Model.Count==0){<section class="empty-state"><span class="empty-icon">⌁</span><h3>No entries just yet</h3><p>Explore the event board and choose your next challenge.</p><a class="btn" asp-controller="Events" asp-action="Index">Explore events →</a></section>}else{<div class="manage-list">@foreach(var e in Model){<article class="manage-card"><div class="manage-art">⌁</div><div class="manage-main"><span class="status-chip @(e.Status=="Confirmed"?"active":"muted")">@e.Status</span><h3>@(e.Category?.Event?.EventName??"Event category")</h3><p>@(e.Category?.CategoryName??"Category") · @(e.Category?.Event?.EventDate.ToString("dd MMM yyyy")??"Date pending") · Entry date: @e.EnrolmentDate.ToString("dd MMM yyyy")</p></div><form asp-action="Cancel" method="post" onsubmit="return confirm('Cancel this entry?')"><input type="hidden" name="id" value="@e.EnrolmentId"/><button class="btn btn-small btn-danger" type="submit">Cancel entry</button></form></article>}</div>}
