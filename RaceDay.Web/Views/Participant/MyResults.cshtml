@model List<ResultVm>
@{ ViewData["Title"]="My results"; }
<section class="page-intro"><span class="eyebrow">YOUR PERSONAL RECORD</span><h1>My results<span class="period">.</span></h1><p>Every result is a reminder of what you can achieve.</p></section>
@if(!string.IsNullOrWhiteSpace(ViewBag.ApiError as string)){<div class="alert error">@ViewBag.ApiError</div>}
@if(Model.Count==0){<section class="empty-state"><span class="empty-icon">↗</span><h3>Your results will appear here.</h3><p>Once an organiser records your race result, you can review your finish time and position here.</p><a class="btn" asp-controller="Events" asp-action="Index">Find an event</a></section>}else{<div class="table-wrap"><table><thead><tr><th>Event</th><th>Finish time</th><th>Position</th><th>Status</th></tr></thead><tbody>@foreach(var r in Model){<tr><td><strong>@(r.Enrolment?.Category?.Event?.EventName??r.Enrolment?.Category?.CategoryName??"Race event")</strong><small class="table-sub">@(r.Enrolment?.Category?.CategoryName??"")</small><small class="table-sub">Result #@r.ResultId</small></td><td>@(r.FinishTime?.ToString(@"hh\:mm\:ss")??"Not recorded")</td><td><span class="rank">@(r.Position?.ToString()??"—")</span></td><td><span class="status-chip active">@r.Status</span></td></tr>}</tbody></table></div>}
