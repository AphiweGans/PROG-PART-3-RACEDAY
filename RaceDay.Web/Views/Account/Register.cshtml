@model RegisterVm
@{ ViewData["Title"] = "Create an account"; }
<section class="auth-layout"><div class="auth-aside"><span class="eyebrow">YOUR NEXT CHAPTER</span><h1>Big goals.<br/><em>Small steps.</em><br/>One finish.</h1><p>Join a community that celebrates progress, personal bests and the courage to start.</p><div class="auth-motto">EVERY LEVEL. EVERY JOURNEY.</div></div><div class="auth-panel"><span class="eyebrow">GET STARTED</span><h2>Create account<span class="period">.</span></h2><p>Choose the account that matches your role.</p><form asp-action="Register" method="post" class="form-stack"><div asp-validation-summary="ModelOnly" class="validation"></div><label asp-for="FullName">Full name</label><input asp-for="FullName" placeholder="Your full name"/><span asp-validation-for="FullName" class="validation"></span><label asp-for="Email">Email address</label><input asp-for="Email" type="email" placeholder="you@example.com"/><span asp-validation-for="Email" class="validation"></span><label asp-for="Password">Password</label><input asp-for="Password" type="password" minlength="8" placeholder="At least 8 characters"/><span asp-validation-for="Password" class="validation"></span><label asp-for="Role">I am joining as</label><select asp-for="Role"><option value="Participant">Participant — enter events</option><option value="Organiser">Organiser — manage events</option></select><div class="form-hint">Organisers can create and manage race events. Participants can enter events and view their results.</div><button class="btn btn-full" type="submit">Create my account →</button></form><div class="form-bottom">Already registered? <a asp-action="Login">Log in</a></div></div></section>
