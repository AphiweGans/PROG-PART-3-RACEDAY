@model LoginVm
@{ ViewData["Title"] = "Log in"; }
<section class="auth-layout"><div class="auth-aside"><span class="eyebrow">WELCOME BACK</span><h1>Ready for<br/><em>your next</em><br/>finish line?</h1><p>Pick up where you left off. Your events, entries and results are all waiting for you.</p><div class="auth-motto">RACE. MOVE. ACHIEVE.</div></div><div class="auth-panel"><span class="eyebrow">YOUR RACEDAY ACCOUNT</span><h2>Log in<span class="period">.</span></h2><p>Enter your details to continue.</p><form asp-action="Login" method="post" class="form-stack"><div asp-validation-summary="ModelOnly" class="validation"></div><label asp-for="Email">Email address</label><input asp-for="Email" type="email" placeholder="you@example.com" autocomplete="email"/><span asp-validation-for="Email" class="validation"></span><label asp-for="Password">Password</label><input asp-for="Password" type="password" placeholder="At least 8 characters" autocomplete="current-password"/><span asp-validation-for="Password" class="validation"></span><button class="btn btn-full" type="submit">Log in to RaceDay →</button></form><div class="form-bottom">New to RaceDay? <a asp-action="Register">Create an account</a></div></div></section>
