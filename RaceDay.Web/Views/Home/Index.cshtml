@model List<EventVm>
@{ ViewData["Title"] = "Find your next finish line"; }
<section class="hero"><div class="hero-copy"><span class="eyebrow"><span class="live-dot"></span> YOUR NEXT CHALLENGE STARTS HERE</span><h1>Find your pace.<br/><span>Own your finish.</span></h1><p>Discover running, walking and cycling events, enter your next challenge and celebrate every kilometre with RaceDay.</p><div class="hero-actions"><a class="btn" asp-controller="Events" asp-action="Index">Explore events <span>↗</span></a><a class="text-link" asp-controller="Account" asp-action="Register">Join the community →</a></div><div class="hero-stats"><div><strong>01</strong><span>Find an event</span></div><div><strong>02</strong><span>Make your move</span></div><div><strong>03</strong><span>Own your finish</span></div></div></div><div class="hero-art"><div class="art-orbit orbit-one"></div><div class="art-orbit orbit-two"></div><div class="art-card"><span class="art-label">THE ONLY COMPETITION</span><strong>IS WHO<br/>YOU WERE<br/><em>YESTERDAY.</em></strong><span class="art-route">RACEDAY / EST. 2026</span></div><div class="art-chip chip-top">↗ NEW GOALS</div><div class="art-chip chip-bottom">● EVERY LEVEL WELCOME</div></div></section>
<section class="section-heading"><div><span class="eyebrow">ON THE CALENDAR</span><h2>Upcoming events</h2><p>Choose a challenge that moves you.</p></div><a class="text-link" asp-controller="Events" asp-action="Index">View all events →</a></section>
@if (!string.IsNullOrWhiteSpace(ViewBag.ApiError as string)) { <div class="alert error">@ViewBag.ApiError</div> }
@if(Model.Count == 0) { <section class="empty-state"><span class="empty-icon">↗</span><h3>Your next finish line is waiting.</h3><p>No upcoming events are listed yet. Organisers can sign in to publish the first one.</p><a class="btn" asp-controller="Account" asp-action="Register">Get started</a></section> }
else { <div class="event-grid">@foreach(var e in Model.Take(6)) { <article class="event-card"><div class="event-image" style="@(string.IsNullOrWhiteSpace(e.ImageUrl) ? "" : $"background-image:linear-gradient(180deg,transparent,rgba(7,25,22,.55)),url('{e.ImageUrl}')")"><span class="type-tag">@((new[]{"RUN","WALK","CYCLE"}.ElementAtOrDefault(e.EventType)) ?? "EVENT")</span><span class="event-distance">@e.Distance.ToString("0.##") KM</span>@if(string.IsNullOrWhiteSpace(e.ImageUrl)){<span class="image-graphic">@(e.EventType==2?"↗":e.EventType==1?"◉":"⌁")</span>}</div><div class="event-card-body"><div class="event-date">@e.EventDate.ToString("dd MMM yyyy") <span>·</span> @e.Location</div><h3>@e.EventName</h3><p>@(string.IsNullOrWhiteSpace(e.Description)?"Make this event your next personal milestone.":e.Description)</p><a class="card-link" asp-controller="Events" asp-action="Details" asp-route-id="@e.EventId">Event details <span>↗</span></a></div></article> }</div> }
<section class="cta-band"><div><span class="eyebrow">YOUR JOURNEY. YOUR PACE.</span><h2>Every kilometre counts.</h2><p>Sign up, track your entries and keep your results in one place.</p></div><a class="btn btn-light" asp-controller="Account" asp-action="Register">Create your account →</a></section>
