@model EventVm
@{ ViewData["Title"] = Model.EventName; var cats = ViewBag.Categories as List<CategoryVm> ?? new(); }
<a class="back-link" asp-action="Index">← Back to events</a><section class="detail-hero"><div class="detail-image" style="@(string.IsNullOrWhiteSpace(Model.ImageUrl)?"":$"background-image:linear-gradient(180deg,transparent,rgba(7,25,22,.4)),url('{Model.ImageUrl}')")"><span class="type-tag">@((new[]{"RUN","WALK","CYCLE"}.ElementAtOrDefault(Model.EventType))??"EVENT")</span>@if(string.IsNullOrWhiteSpace(Model.ImageUrl)){<span class="detail-symbol">@(Model.EventType==2?"↗":Model.EventType==1?"◉":"⌁")</span>}</div><div class="detail-copy"><span class="eyebrow">EVENT DETAILS</span><h1>@Model.EventName<span class="period">.</span></h1><p>@Model.Description</p><div class="detail-facts"><div><span>DATE</span><strong>@Model.EventDate.ToString("dd MMM yyyy")</strong></div><div><span>LOCATION</span><strong>@Model.Location</strong></div><div><span>DISTANCE</span><strong>@Model.Distance.ToString("0.##") km</strong></div></div></div></section>
<section class="section-heading"><div><span class="eyebrow">CHOOSE YOUR CHALLENGE</span><h2>Available categories</h2><p>Select the distance that suits your goals.</p></div></section>
@if(cats.Count==0){<div class="empty-state compact"><h3>Categories coming soon</h3><p>The organiser has not added entry categories yet.</p></div>}else{<div class="category-list">@foreach(var c in cats){<article class="category-row"><div class="category-icon">↗</div><div class="category-info"><h3>@c.CategoryName</h3><span>@c.DistanceKm km · Limit @c.MaxParticipants participants</span></div><div class="category-price">R @c.EntryFee.ToString("0.00")</div>@if(Context.Session.GetString("UserRole")=="Participant"){<form asp-action="Enter" method="post"><input type="hidden" name="categoryId" value="@c.CategoryId"/><input type="hidden" name="eventId" value="@Model.EventId"/><button class="btn btn-small" type="submit">Enter event →</button></form>}else if(string.IsNullOrEmpty(Context.Session.GetString("UserRole"))){<a class="btn btn-small" asp-controller="Account" asp-action="Login">Log in to enter</a>}</article>}</div>}
