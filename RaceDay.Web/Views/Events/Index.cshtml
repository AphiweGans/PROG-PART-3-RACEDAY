@model List<EventVm>
@{ ViewData["Title"] = "Explore events"; }
<section class="page-intro"><span class="eyebrow">THE EVENT BOARD</span><h1>Explore events<span class="period">.</span></h1><p>From your first 5K to your next big ride, there is a challenge with your name on it.</p></section>
@if (!string.IsNullOrWhiteSpace(ViewBag.ApiError as string)) { <div class="alert error">@ViewBag.ApiError</div> }
@if(Model.Count==0){<section class="empty-state"><h3>No upcoming events yet</h3><p>Check back soon or register as an Organiser to create an event.</p><a class="btn" asp-controller="Account" asp-action="Register">Join RaceDay</a></section>} else {<div class="event-grid">@foreach(var e in Model){<article class="event-card"><div class="event-image" style="@(string.IsNullOrWhiteSpace(e.ImageUrl)?"":$"background-image:linear-gradient(180deg,transparent,rgba(7,25,22,.55)),url('{e.ImageUrl}')")"><span class="type-tag">@((new[]{"RUN","WALK","CYCLE"}.ElementAtOrDefault(e.EventType))??"EVENT")</span><span class="event-distance">@e.Distance.ToString("0.##") KM</span>@if(string.IsNullOrWhiteSpace(e.ImageUrl)){<span class="image-graphic">@(e.EventType==2?"↗":e.EventType==1?"◉":"⌁")</span>}</div><div class="event-card-body"><div class="event-date">@e.EventDate.ToString("dd MMM yyyy") <span>·</span> @e.Location</div><h3>@e.EventName</h3><p>@(e.Description??"Make this event your next personal milestone.")</p><a class="card-link" asp-action="Details" asp-route-id="@e.EventId">View details <span>↗</span></a></div></article>}</div>}
